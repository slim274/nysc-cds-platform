# API configuration
PORT=3001

# Local private storage for corps member profile photographs.
# In production, point this to a persistent, encrypted, access-restricted volume.
CORPS_MEMBER_PHOTO_DIR=.data/corps-member-photos

# Use a unique random secret (at least 32 bytes) for HMAC-based verification throttling.
IDENTITY_VERIFICATION_PEPPER=replace-with-a-random-secret-at-least-32-bytes-long

# HMAC secret for API throttling keys (at least 32 bytes; use a unique random value).
API_RATE_LIMIT_PEPPER=replace-with-a-random-secret-at-least-32-bytes-long

# Set true only when a trusted reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# Corps Member onboarding OTP
# Use console only in local development; production must use real delivery providers.
OTP_DELIVERY_MODE=console
OTP_HASH_PEPPER=replace-with-a-different-random-secret-at-least-32-bytes-long

# Resend transactional email (required for email OTP in provider mode).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Termii SMS (required for SMS OTP in provider mode).
TERMII_API_KEY=
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_SENDER_ID=
TERMII_CHANNEL=dnd

# Document verification mode:
# manual = no paid AI calls; LGI reviews submitted documents from the exception queue.
# ai = OpenAI checks document type, member details and reference-sample layout.
# If AI mode is selected without an API key, submissions safely fall back to LGI review.
DOCUMENT_VERIFICATION_MODE=manual
OPENAI_API_KEY=
DOCUMENT_VERIFICATION_MODEL=gpt-4.1-mini
CORPS_MEMBER_DOCUMENT_DIR=.data/corps-member-documents
