# API configuration
PORT=3001

# Local private storage for corps member profile photographs.
# In production, point this to a persistent, encrypted, access-restricted volume.
CORPS_MEMBER_PHOTO_DIR=.data/corps-member-photos

# Use a unique random secret (at least 32 bytes) for HMAC-based verification throttling.
IDENTITY_VERIFICATION_PEPPER=replace-with-a-random-secret-at-least-32-bytes-long

# Set true only when a trusted reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=false
