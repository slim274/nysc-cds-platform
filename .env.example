# PostgreSQL (used by Docker Compose and the API)
POSTGRES_DB=nysc_cds
POSTGRES_USER=nysc_user
POSTGRES_PASSWORD=replace_with_a_long_random_password
DATABASE_URL=postgresql://nysc_user:replace_with_a_long_random_password@localhost:5432/nysc_cds?sslmode=disable

# Grafana local development login.
# Change this password before making Grafana accessible outside your machine.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_a_different_long_random_password
