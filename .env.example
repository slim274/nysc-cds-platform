# PostgreSQL. Use URL-safe hexadecimal passwords so Compose can construct
# the internal DATABASE_URL without URL-encoding issues.
POSTGRES_DB=nysc_cds
POSTGRES_USER=nysc_app
POSTGRES_PASSWORD=replace-with-a-unique-random-postgres-password
# Host-side URL for Drizzle migrations and local Bun development.
DATABASE_URL=postgresql://nysc_app:replace-with-a-unique-random-postgres-password@127.0.0.1:5432/nysc_cds

# Nginx HTTP port for the containerised application profile.
APP_PORT=8080

# API and local HTTP cookie/security settings.
PORT=3001
COOKIE_SECURE=false
HSTS_ENABLED=false

# Redis distributed rate limiting.
REDIS_PASSWORD=replace-with-a-unique-random-redis-password
REDIS_URL=redis://:replace-with-a-unique-random-redis-password@127.0.0.1:6379/0

# Local storage locations. Compose maps these to persistent named volumes.
CORPS_MEMBER_PHOTO_DIR=.data/corps-member-photos
CORPS_MEMBER_DOCUMENT_DIR=.data/corps-member-documents

# Unique random HMAC secrets (at least 32 bytes each).
IDENTITY_VERIFICATION_PEPPER=replace-with-a-random-secret-at-least-32-bytes-long
API_RATE_LIMIT_PEPPER=replace-with-a-random-secret-at-least-32-bytes-long
OTP_HASH_PEPPER=replace-with-a-different-random-secret-at-least-32-bytes-long

# Set true only behind the trusted Nginx proxy configured in this profile.
TRUST_PROXY_HEADERS=false

# OTP providers. Console mode is for local development only.
OTP_DELIVERY_MODE=console
RESEND_API_KEY=
RESEND_FROM_EMAIL=
TERMII_API_KEY=
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_SENDER_ID=
TERMII_CHANNEL=dnd

# Document verification.
DOCUMENT_VERIFICATION_MODE=manual
OPENAI_API_KEY=
DOCUMENT_VERIFICATION_MODEL=gpt-4.1-mini
