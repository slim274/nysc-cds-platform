      "targets": [
        {
          "expr": "probe_success{instance=\"http://host.docker.internal:3001/health\"}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
